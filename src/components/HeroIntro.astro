---
/**
 * Home hero + Focus-pull intro. The intro animates the real hero (no overlay),
 * so the page and its main image are there from the first frame. It runs once per
 * session and is skipped for reduced-motion users (decided in the <head> script on index).
 */
import Img from './Img.astro';
import type { Hero } from '../lib/types';

interface Props {
  heroes: Hero[];
  tagline?: string;
}

const { heroes, tagline = 'Patience, then focus.' } = Astro.props;
const [line1, ...rest] = tagline.split(/,\s*/);
const line2 = rest.join(', ');
---

<section class="hero-sec wrap" aria-label="Featured photograph">
  <div class="hero protect" data-hero>
    {
      heroes.map((h, i) => {
        const hs = h.photo.image.hotspot ?? { x: 0.6, y: 0.38 };
        const e = h.photo.exif;
        const meta = [h.photo.species[0]?.name, h.photo.location].filter(Boolean).join(' · ');
        return (
          <figure class="hero-item" data-i={i} hidden={i !== 0} style={`--hx:${hs.x};--hy:${hs.y}`}>
            <div class="hero-media">
              <Img img={h.photo.image} alt={h.photo.alt} eager={i === 0} sizes="100vw" />
            </div>
            <div class="veil" aria-hidden="true" />
            <div class="af" aria-hidden="true">
              <div class="brackets">
                <i />
                <i />
                <i />
                <i />
              </div>
              <span class="af-label mono">● AF-C · LOCKED</span>
            </div>
            <figcaption class="readout mono">
              <span class="exp">
                {e.shutter && <span>{e.shutter}</span>}
                {e.aperture && <span>{e.aperture}</span>}
                {e.iso && <span>ISO {e.iso}</span>}
                {e.lens && <span class="lens">{e.lens}</span>}
              </span>
              <span class="where">
                {meta}
                {h.href && (
                  <a href={h.href} class="view">
                    View →
                  </a>
                )}
              </span>
            </figcaption>
          </figure>
        );
      })
    }
    <div class="hero-copy">
      <p class="label label-accent">Ayush Gandhi · Photography</p>
      <h1>
        {line1}
        {line2 && ','}
        {line2 && <br />}
        {line2 && <span class="accent">{line2}</span>}
      </h1>
    </div>
    <div class="intro-ctl">
      <button class="pill ctl" type="button" data-sound aria-pressed="false">Sound off</button>
      <button class="pill ctl" type="button" data-skip>Skip intro →</button>
    </div>
  </div>
</section>

<script is:inline>
  // Pick one hero from the pool for this visit.
  (() => {
    const items = document.querySelectorAll('[data-hero] .hero-item');
    if (items.length < 2) return;
    const i = Math.floor(Math.random() * items.length);
    if (i === 0) return;
    items[0].hidden = true;
    items[i].hidden = false;
    const img = items[i].querySelector('img');
    if (img) {
      img.loading = 'eager';
      img.fetchPriority = 'high';
    }
  })();
</script>

<script>
  const root = document.documentElement;
  const soundBtn = document.querySelector<HTMLButtonElement>('[data-sound]');
  const skipBtn = document.querySelector<HTMLButtonElement>('[data-skip]');

  const read = () => {
    try {
      return localStorage.getItem('ag-sound') === '1';
    } catch {
      return false;
    }
  };
  const paint = (on: boolean) => {
    if (!soundBtn) return;
    soundBtn.setAttribute('aria-pressed', String(on));
    soundBtn.textContent = on ? 'Sound on' : 'Sound off';
  };

  /** A soft two-part shutter click, synthesised so there is no audio file to download. */
  function shutter() {
    try {
      const ctx = new AudioContext();
      const burst = (at: number) => {
        const len = Math.floor(ctx.sampleRate * 0.05);
        const buf = ctx.createBuffer(1, len, ctx.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 4);
        const src = ctx.createBufferSource();
        src.buffer = buf;
        const hp = ctx.createBiquadFilter();
        hp.type = 'highpass';
        hp.frequency.value = 1800;
        const g = ctx.createGain();
        g.gain.value = 0.35;
        src.connect(hp).connect(g).connect(ctx.destination);
        src.start(ctx.currentTime + at);
      };
      burst(0);
      burst(0.07);
    } catch {
      /* Browsers may block audio before the first interaction; stay silent. */
    }
  }

  paint(read());
  soundBtn?.addEventListener('click', () => {
    const on = !read();
    try {
      localStorage.setItem('ag-sound', on ? '1' : '0');
    } catch {}
    paint(on);
    if (on) shutter();
  });

  skipBtn?.addEventListener('click', () => root.classList.remove('intro'));

  if (root.classList.contains('intro')) {
    if (read()) setTimeout(shutter, 1000);
    setTimeout(() => root.classList.remove('intro'), 4200);
  }
</script>

<style>
  .hero-sec {
    padding-top: 8px;
  }
  .hero {
    position: relative;
    height: clamp(520px, calc(100svh - 108px), 900px);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--photo-bg);
  }
  .hero-item {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .hero-item[hidden] {
    display: none;
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .veil {
    position: absolute;
    inset: 0;
    background: var(--photo-bg);
    opacity: 0;
    pointer-events: none;
  }
  .hero-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(10 12 9 / 0.75) 0%, transparent 45%);
    pointer-events: none;
  }
  .af {
    position: absolute;
    z-index: 2;
    width: 170px;
    height: 128px;
    left: calc(var(--hx) * 100% - 85px);
    top: calc(var(--hy) * 100% - 64px);
  }
  .af .brackets {
    inset: 0;
    --s: 28px;
    --b: #c9dbbe;
  }
  .af-label {
    position: absolute;
    left: 0;
    top: -24px;
    font-size: 11px;
    color: #c9dbbe;
    white-space: nowrap;
  }
  .hero-copy {
    position: absolute;
    z-index: 3;
    left: clamp(20px, 4vw, 56px);
    right: 20px;
    bottom: clamp(96px, 12vh, 120px);
    color: #e7ecdf;
    pointer-events: none;
  }
  .hero-copy .label {
    color: #c9dbbe;
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(52px, 8vw, 124px);
    line-height: 0.88;
    letter-spacing: -0.05em;
  }
  .accent {
    color: #c9dbbe;
  }
  .readout {
    position: absolute;
    z-index: 3;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding: 14px 20px;
    border-radius: 14px;
    background: rgb(20 24 19 / 0.72);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: #e7ecdf;
    font-size: 13px;
  }
  .exp {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .lens,
  .view {
    color: #c9dbbe;
  }
  .where {
    display: flex;
    gap: 16px;
    color: #b9c2b1;
  }
  .view:hover {
    color: #fff;
  }
  .intro-ctl {
    position: absolute;
    z-index: 4;
    right: 20px;
    top: 20px;
    display: none;
    gap: 8px;
  }
  .ctl {
    background: rgb(20 24 19 / 0.8);
    color: #e7ecdf;
    border-color: #3a4436;
  }

  /* ---------- Focus-pull intro ---------- */
  :global(html.intro) .intro-ctl {
    display: flex;
    animation: fade-in 0.4s 0.3s both;
  }
  :global(html.intro) .hero-media {
    animation: pull 1.5s var(--ease) 0.7s both;
  }
  :global(html.intro) .veil {
    animation: veil 1.8s 0.2s both;
  }
  :global(html.intro) .af {
    animation: hunt 1.1s cubic-bezier(0.3, 0.7, 0.3, 1) 0.1s both;
  }
  :global(html.intro) .af .brackets > i {
    animation: lock 1.2s 0.1s both;
  }
  :global(html.intro) .af-label {
    animation: fade-in 0.3s 1s both;
  }
  :global(html.intro) .readout {
    animation: fade-in 0.4s 1.9s both;
  }
  :global(html.intro) .hero-copy {
    animation: rise 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 2.3s both;
  }
  :global(html.intro .site-header) {
    animation: fade-in 0.5s 3s both;
  }

  @keyframes pull {
    from { filter: blur(28px) brightness(0.5); transform: scale(1.06); }
    to { filter: none; transform: none; }
  }
  @keyframes veil {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  @keyframes hunt {
    0% { transform: translate(-30vw, 18vh) scale(2.6); }
    30% { transform: translate(10vw, -6vh) scale(1.7); }
    50% { transform: translate(-3vw, 3vh) scale(1.2); }
    65% { transform: translate(0.6vw, -0.5vh) scale(1.04); }
    75%, 100% { transform: none; }
  }
  @keyframes lock {
    0%, 72% { border-color: #e7ecdf; }
    76% { border-color: #c9dbbe; filter: drop-shadow(0 0 12px #c9dbbe); }
    100% { border-color: #c9dbbe; }
  }
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(60px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 640px) {
    .readout .exp span:not(:first-child):not(.lens) {
      display: none;
    }
    .hero-copy {
      bottom: 136px;
    }
    .af {
      width: 120px;
      height: 90px;
      left: calc(var(--hx) * 100% - 60px);
      top: calc(var(--hy) * 100% - 45px);
    }
  }
</style>
