# Copy to .env for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.

# Your Sanity project (sanity.io/manage → your project → Project ID).
# Leave empty to run the site with built-in demo content.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed if you make the dataset private. Create a "Viewer" token in
# sanity.io/manage → API → Tokens. Never commit the real value.
SANITY_API_READ_TOKEN=

# The live address of the site, no trailing slash.
SITE_URL=https://ayush-gandhi-photography.vercel.app
