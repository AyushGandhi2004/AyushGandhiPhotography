---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { categoryTitle, getContent } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { ogUrl } from '../../lib/image';
import { renderBody } from '../../lib/portable';
import { article, breadcrumb } from '../../lib/seo';
import type { Story } from '../../lib/types';

export async function getStaticPaths() {
  const content = await getContent();
  return content.stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

interface Props {
  story: Story;
}

const { story } = Astro.props;
const content = await getContent();
const album = story.albumId ? content.albums.find((a) => a.id === story.albumId) : undefined;
const more = content.stories.filter((s) => s.id !== story.id).slice(0, 3);
const html = renderBody(story.body);
const catName = categoryTitle(content, story.category);
const ld = [
  article(story, Astro.site),
  breadcrumb(
    [
      { name: 'Home', path: '/' },
      { name: 'Journal', path: '/journal/' },
      { name: story.title, path: story.href },
    ],
    Astro.site,
  ),
];
---

<Base title={story.title} description={story.standfirst} image={ogUrl(story.cover)} nav="journal" jsonLd={ld} ogType="article">
  <div class="progress" aria-hidden="true" data-progress></div>
  <article>
    <header class="story-head">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/journal/">Journal</a>{catName && ' / '}{catName && <a href={`/${story.category}/`}>{catName}</a>}
      </nav>
      <h1 class="title">{story.title}</h1>
      {story.standfirst && <p class="standfirst">{story.standfirst}</p>}
      <p class="mono meta">{[formatDate(story.publishedAt), `${story.readMins} min read`].filter(Boolean).join(' · ')}</p>
    </header>

    {
      story.cover && (
        <div class="wrap">
          <div class="cover protect">
            <Img img={story.cover} alt={story.coverAlt ?? story.title} eager sizes="100vw" />
          </div>
        </div>
      )
    }

    <div class="prose" set:html={html} />

    {
      album && (
        <div class="album-link">
          <a class="card al" href={album.href}>
            <span class="al-img">
              <Img img={album.cover?.image} alt={album.cover?.alt ?? album.title} sizes="220px" />
            </span>
            <span class="al-text">
              <span class="label label-accent">See all photos from this trip</span>
              <span class="al-title">{album.title}</span>
              <span class="mono meta">
                {album.photos.length} frames · {categoryTitle(content, album.category)}
              </span>
            </span>
            <span class="arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      )
    }
  </article>

  {
    more.length > 0 && (
      <section class="wrap section" aria-labelledby="more-title">
        <h2 id="more-title" class="section-title more-title">
          More stories
        </h2>
        <div class="more">
          {more.map((s) => (
            <a class="more-card" href={s.href}>
              <span class="more-img">
                <Img img={s.cover} alt={s.coverAlt ?? s.title} sizes="(max-width: 640px) 100vw, 33vw" />
              </span>
              <span class="more-t">{s.title}</span>
              <span class="mono meta">
                {[formatDate(s.publishedAt), `${s.readMins} min`].filter(Boolean).join(' · ')}
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector('article');
  if (bar && article) {
    const update = () => {
      const r = article.getBoundingClientRect();
      const total = r.height - innerHeight;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, -r.top / (total > 0 ? total : 1)))})`;
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .progress {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    width: 100%;
    height: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .story-head {
    max-width: 880px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 64px) var(--gutter) 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .title {
    font-size: clamp(36px, 6vw, 84px);
    letter-spacing: -0.045em;
  }
  .standfirst {
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.6;
    color: var(--text-soft);
  }
  .meta {
    font-size: 12px;
    color: var(--muted);
  }
  .cover {
    height: clamp(320px, 60vh, 640px);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px var(--gutter) 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .prose :global(p) {
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.75;
    color: var(--text-soft);
  }
  .prose :global(h2) {
    margin-top: 24px;
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 700;
    line-height: 1.1;
  }
  .prose :global(h3) {
    margin-top: 12px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }
  .prose :global(blockquote) {
    margin: 16px 0;
    padding: 8px 0 8px 28px;
    border-left: 3px solid var(--accent);
    font: 700 clamp(24px, 2.6vw, 32px) / 1.25 var(--display);
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .prose :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0;
    padding-left: 1.2em;
    color: var(--text-soft);
    font-size: 18px;
    line-height: 1.7;
  }
  .prose :global(figure) {
    margin: 24px calc(-1 * clamp(0px, (100vw - 780px) / 2, 200px));
    display: grid;
    gap: 12px;
  }
  .prose :global(.pt-pair) {
    grid-template-columns: 1fr 1fr;
  }
  .prose :global(.pt-img) {
    width: 100%;
    height: auto;
    border-radius: 16px;
    background-color: var(--surface);
  }
  .prose :global(figcaption) {
    grid-column: 1 / -1;
    font-size: 12px;
    color: var(--muted);
  }
  .prose :global(.pt-video iframe) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 16px;
  }
  .album-link {
    max-width: 880px;
    margin: 64px auto 0;
    padding: 0 var(--gutter);
  }
  .al {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: 18px;
    color: var(--text);
  }
  .al:hover {
    border-color: var(--accent-ink);
    color: var(--text);
  }
  .al-img {
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: 12px;
    overflow: hidden;
  }
  .al-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .al-title {
    font: 700 24px var(--display);
    letter-spacing: -0.02em;
  }
  .arrow {
    color: var(--accent-ink);
    padding-right: 8px;
  }
  .more-title {
    font-size: 28px;
    margin-bottom: 20px;
  }
  .more {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  .more-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--text);
  }
  .more-img {
    display: block;
    aspect-ratio: 3 / 2;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .more-t {
    font: 700 20px var(--display);
    letter-spacing: -0.02em;
  }
  @media (max-width: 760px) {
    .prose :global(figure) {
      margin-inline: 0;
    }
    .prose :global(.pt-pair) {
      grid-template-columns: 1fr;
    }
    .al {
      grid-template-columns: minmax(0, 1fr);
    }
    .arrow {
      display: none;
    }
  }
</style>
